{
  "owners": ["caiolima@igalia.com"],
  "name": "ImportDefer",
  "run_count": 1,
  "run_count_arm": 1,
  "run_count_arm64": 1,
  "timeout": 120,
  "timeout_arm64": 240,
  "units": "score",
  "flags": ["--allow-natives-syntax", "--js-defer-import-eval"],
  "resources": ["base.js"],
  "tests": [
    {
      "name": "Throughput",
      "path": ["ImportDefer"],
      "main": "run.js",
      "results_regexp": "^%s\\-ImportDefer\\(Score\\): (.+)$",
      "resources": ["value.js", "hotaccess-eager.js", "hotaccess-defer.js"],
      "tests": [
        {"name": "HotAccessEager"},
        {"name": "HotAccessDefer"}
      ]
    },
    {
      "name": "WallClock",
      "path": ["ImportDefer"],
      "main": "wallclock.js",
      "units": "ms",
      "results_regexp": "^%s\\-ImportDeferWallClock\\(Score\\): (.+)$",
      "resources": [
        "heavy-loop.js", "heavy-toplevel.js",
        "ns-no-access-eager.js", "ns-no-access-defer.js",
        "latency-eager.js", "latency-defer.js",
        "large-bytecode-eager.js", "large-bytecode-defer.js",
        "alwaysused-eager.js", "alwaysused-defer.js"
      ],
      "tests": [
        {"name": "NsNoAccessEager"},
        {"name": "NsNoAccessDefer"},
        {"name": "LatencyEager"},
        {"name": "LatencyDefer"},
        {"name": "LargeBytecodeEager"},
        {"name": "LargeBytecodeDefer"},
        {"name": "AlwaysUsedEager"},
        {"name": "AlwaysUsedDefer"}
      ]
    }
  ]
}
